# Xcode / SPM
ios/*.xcodeproj/
ios/*.xcworkspace/
**/DerivedData/
**/.build/
**/.swiftpm/
**/xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Secrets / local signing (never commit a real team id override)
ios/local.xcconfig
ios/App/XAISecrets.plist
server/.env
server/node_modules/

# Device session diagnostics (share locally; do not commit)
logs/

# Local visual-companion mockups
.superpowers/

# Reference screen recordings (too large for git; extracted frames are committed)
inspo/*.MP4
inspo/*.mp4
inspo/*.mov
inspo/*.MOV

# Feedback eval: generated audio, your own voice recordings, Grok caches, reports
eval/feedback/clips/generated/
eval/feedback/clips/real/*
!eval/feedback/clips/real/README.md
eval/feedback/out/

# Fastlane / CI build output
ios/build/
ios/fastlane/report.xml
ios/fastlane/README.md
ios/fastlane/test_output/
ios/vendor/
# CI-generated provider keys (XOR-masked). Never commit.
ios/App/Generated/
