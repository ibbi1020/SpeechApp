# frozen_string_literal: true

require "base64"
require "shellwords"

# Orator (SpeechApp) iOS -> TestFlight
#
# Project: SpeechApp.xcodeproj (generated by XcodeGen from project.yml in CI)
# Scheme/target: SpeechApp
#
# project.yml keeps the local-dev settings (bundle id com.speechapp.prototype.format1,
# Personal Team 45SVH8S72R, automatic signing) so Xcode runs on a personal device keep
# working. CI rewrites ONLY the Release config of the SpeechApp target to:
#   team       Q2Z32YFFGP (Muhammad Yahya Qureshi)
#   bundle id  com.speechapp.orator
#   signing    manual, Apple Distribution + App Store profile "Orator App Store CI"
#
# Auth: App Store Connect API key. Signing: Distribution .p12 + App Store profile from
# repo secrets (no match). Never put PROVISIONING_PROFILE_SPECIFIER in global xcargs:
# SPM products (SpeechAppKit) do not take provisioning profiles.

DEFAULT_TEAM_ID = "Q2Z32YFFGP"
DEFAULT_APP_IDENTIFIER = "com.speechapp.orator"
DEFAULT_PROFILE_NAME = "Orator App Store CI"
APP_TARGET = "SpeechApp"
SCHEME = "SpeechApp"
XCODEPROJ = "SpeechApp.xcodeproj"
INFO_PLIST = "App/Info.plist"
# Repo baseline CFBundleVersion. CI default is run_number + BUILD_OFFSET so the
# first CI build is above anything built locally.
BUILD_OFFSET = 3

def env_or(name, default)
  v = ENV[name]&.strip
  v.nil? || v.empty? ? default : v
end

def team_id = env_or("APPLE_TEAM_ID", DEFAULT_TEAM_ID)
def app_identifier = env_or("IOS_APP_IDENTIFIER", DEFAULT_APP_IDENTIFIER)
def profile_specifier = env_or("IOS_APPSTORE_PROVISIONING_PROFILE_SPECIFIER", DEFAULT_PROFILE_NAME)

def resolve_build_number
  explicit = ENV["BUILD_NUMBER"]&.strip
  return explicit unless explicit.nil? || explicit.empty?

  run = ENV["GITHUB_RUN_NUMBER"].to_i
  return (run + BUILD_OFFSET).to_s if run.positive?

  (BUILD_OFFSET + 1).to_s
end

def load_asc_api_key
  key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY")
  is_base64 = !key_content.include?("BEGIN PRIVATE KEY")
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: key_content,
    is_key_content_base64: is_base64,
    duration: 1200,
    in_house: false
  )
end

def import_distribution_certificate!
  cert_b64 = ENV["IOS_DISTRIBUTION_CERTIFICATE_BASE64"]
  UI.user_error!("Missing IOS_DISTRIBUTION_CERTIFICATE_BASE64 (Apple Distribution .p12)") if cert_b64.to_s.strip.empty?

  cert_path = File.join(Dir.tmpdir, "orator_distribution.p12")
  File.binwrite(cert_path, Base64.decode64(cert_b64))
  import_certificate(
    certificate_path: cert_path,
    certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD", ""),
    keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
    keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
  )
  UI.success("Imported Apple Distribution certificate into CI keychain")
end

def install_appstore_provisioning_profile!
  profile_b64 = ENV["IOS_APPSTORE_PROVISIONING_PROFILE_BASE64"]
  UI.user_error!("Missing IOS_APPSTORE_PROVISIONING_PROFILE_BASE64 (App Store profile for #{app_identifier})") if profile_b64.to_s.strip.empty?

  profile_path = File.join(Dir.tmpdir, "orator_appstore.mobileprovision")
  File.binwrite(profile_path, Base64.decode64(profile_b64))
  install_provisioning_profile(path: profile_path)
  UI.success("Installed provisioning profile #{profile_specifier}")
end

def configure_release_signing!
  update_code_signing_settings(
    use_automatic_signing: false,
    path: XCODEPROJ,
    targets: [APP_TARGET],
    build_configurations: ["Release"],
    team_id: team_id,
    code_sign_identity: "Apple Distribution",
    profile_name: profile_specifier,
    bundle_identifier: app_identifier
  )
end

def archive!(build_number)
  UI.message("Bundle id=#{app_identifier} team=#{team_id} profile=#{profile_specifier} build=#{build_number}")

  # Info.plist hard-codes CFBundleVersion (XcodeGen writes it from project.yml).
  set_info_plist_value(path: INFO_PLIST, key: "CFBundleVersion", value: build_number)

  import_distribution_certificate!
  install_appstore_provisioning_profile!
  configure_release_signing!

  build_app(
    project: XCODEPROJ,
    scheme: SCHEME,
    configuration: "Release",
    clean: true,
    export_method: "app-store",
    export_options: {
      method: "app-store",
      signingStyle: "manual",
      teamID: team_id,
      provisioningProfiles: { app_identifier => profile_specifier }
    },
    xcargs: "DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)}",
    output_directory: "build",
    output_name: "Orator",
    skip_profile_detection: true
  )
end

def app_record_exists?
  Spaceship::ConnectAPI::App.find(app_identifier) != nil
rescue StandardError => e
  UI.important("Could not look up App Store Connect app #{app_identifier}: #{e.message}")
  false
end

default_platform(:ios)

platform :ios do
  desc "Archive Release IPA and upload to TestFlight (skips upload if no App Store Connect app record yet)"
  lane :testflight_release do
    setup_ci if ENV["CI"]
    api_key = load_asc_api_key
    build_number = resolve_build_number
    archive!(build_number)

    if ENV["SKIP_UPLOAD"] == "true"
      UI.important("SKIP_UPLOAD=true; IPA built at ios/build/Orator.ipa, not uploaded.")
      next
    end

    unless app_record_exists?
      UI.important(
        "No App Store Connect app record for #{app_identifier} in team #{team_id}. " \
        "Create it in App Store Connect (My Apps -> + -> New App), then re-run this workflow. " \
        "IPA was built and signed successfully; upload skipped."
      )
      sh("echo '::warning::App Store Connect app record for #{app_identifier} not found; upload skipped.'")
      next
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_identifier,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      # An empty changelog still makes pilot wait for the build to appear (and hang if
      # processing fails), so pass nil unless there is text.
      changelog: env_or("TESTFLIGHT_CHANGELOG", nil)
    )
    UI.success("Uploaded #{app_identifier} build #{build_number} to TestFlight")
  end
end
